<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">
<head>
  <meta http-equiv="Content-Type" content="text/html;charset=utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="keywords" content="{{ site.keywords }}" />
  <meta name="description" content="{{ site.description }}" />
  <meta name="robots" content="index, follow" />
  <meta property="og:title" content="{{ site.first_name }} {{ site.last_name }}" />
  <meta property="og:description" content="{{ site.description }}" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="{{ site.url }}{{ site.baseurl }}" />
  <link rel="shortcut icon" href="{{ '/assets/img/favicon.ico' | relative_url }}" />
  <link rel="stylesheet" href="{{ '/assets/css/jemdoc.css' | relative_url }}" type="text/css" />
  <title>{{ site.first_name }} {{ site.last_name }}</title>
</head>
<body>
<div id="layout-content" style="margin-top:25px">
  {{ content }}
</div>
</body>
</html>